{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Databasekvalitet (klartekst)",
      "type": "shell",
      "command": "py -3.13 scripts/db_kvalitet.py --problems --stille --rapport apning",
      "presentation": { "reveal": "never", "panel": "dedicated", "clear": true, "focus": false, "showReuseMessage": false, "close": true },
      "runOptions": { "runOn": "folderOpen" },
      "problemMatcher": {
        "owner": "db-kvalitet",
        "fileLocation": ["relative", "${workspaceFolder}"],
        "pattern": {
          "regexp": "^PROBLEM\\|(error|warning)\\|([^|]+)\\|(\\d+)\\|(.*)$",
          "severity": 1,
          "file": 2,
          "line": 3,
          "message": 4
        }
      },
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "Statusport (full, med tester)",
      "type": "shell",
      "command": "py -3.13 scripts/db_status_gate.py",
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "Tester (pytest)",
      "type": "shell",
      "command": "py -3.13 -m pytest -q",
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "problemMatcher": [],
      "group": "test"
    },
    {
      "label": "Åpne kvalitetsrapport",
      "type": "shell",
      "command": "code -r .scratch/kvalitet/RAPPORT.md",
      "presentation": { "reveal": "never", "close": true },
      "problemMatcher": []
    },
    {
      "label": "MVP-fremdrift",
      "type": "shell",
      "command": "py -3.13 -m pytest tests/test_mvp_oppslag.py tests/test_mvp_bemanning.py -q",
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "problemMatcher": []
    }
  ]
}
