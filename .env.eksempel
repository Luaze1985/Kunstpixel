# KI-innstillinger for Datafinner og scripts/chat_eval.py.
# Kopier denne filen til .env (samme mappe) og lim inn nøkkelen. .env ignoreres av git og skal aldri committes.
# Variabler som alt er satt i terminalen, vinner over filen.
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5-5
LLM_API_KEY=
# 600 holder for korte enkeltforklaringer (/api/forklar), 1200–1500 anbefales for flerturs verktøychat (/api/chat).
LLM_MAX_TOKENS=1500
LLM_MAKS_PER_TIME=60
